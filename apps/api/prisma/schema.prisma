// Metalsider — Prisma Schema
// Provider: SQL Server 2022+ / Azure SQL (D-01)
// Nomes de tabelas e colunas em português minúsculo (D-02)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model usuarios {
  id                    String    @id @default(uuid()) @db.UniqueIdentifier
  email                 String    @unique @db.NVarChar(256)
  nome_completo         String    @db.NVarChar(200)
  senha_hash            String?   @db.NVarChar(60)
  perfil                String    @db.NVarChar(20)
  verificado            Boolean   @default(false)
  codigo_verificacao    String?   @db.NVarChar(60)
  codigo_expira_em      DateTime? @db.DateTime2
  cargo                 String?   @db.NVarChar(120)  // D-56
  ativo                 Boolean   @default(true)
  criado_em             DateTime  @default(now()) @db.DateTime2
  ultimo_acesso_em      DateTime? @db.DateTime2

  os_supervisor         ordens_servico[]       @relation("supervisor")
  os_mecanico           ordens_servico[]       @relation("mecanico")
  fechamentos           registros_fechamento[]
  anexos                anexos[]
  logs                  logs_auditoria[]
  analises_checklists   checklist_analises[]

  @@index([ativo])
  @@index([perfil])
  @@index([ativo, perfil])
}

model veiculos {
  id                       Int     @id @default(autoincrement())
  placa                    String? @db.NVarChar(10)
  veiculo                  String  @unique @db.NVarChar(100)
  cod_tipo_aplicacao       String? @db.NVarChar(50)
  descricao_tipo_aplicacao String? @db.NVarChar(200)
  ativo                    Boolean @default(true)

  ordens ordens_servico[]
}

model categorias {
  id    Int     @id @default(autoincrement())
  nome  String  @unique @db.NVarChar(100)
  cor   String? @db.NVarChar(7)
  ativo Boolean @default(true)

  ordens ordens_servico[]
}

model ordens_servico {
  id                         Int       @id @default(autoincrement())
  titulo                     String    @db.NVarChar(300)
  categoria_id               Int
  prioridade                 String    @db.NVarChar(20)
  veiculo_id                 Int
  supervisor_id              String    @db.UniqueIdentifier
  mecanico_id                String?   @db.UniqueIdentifier  // D-13: nullable
  status                     String    @default("aberto") @db.NVarChar(20)
  descricao                  String?   @db.NVarChar(Max)
  notas_internas             String?   @db.NVarChar(Max)
  inicio_previsto            DateTime  @db.DateTime2
  prazo                      DateTime  @db.DateTime2
  fechado_em                 DateTime? @db.DateTime2
  alerta_proximo_enviado_em  DateTime? @db.DateTime2         // D-17: idempotência de alerta
  criado_em                  DateTime  @default(now()) @db.DateTime2
  atualizado_em              DateTime  @updatedAt @db.DateTime2

  // D-26: NoAction em todas as FKs de usuarios para evitar multiple cascade paths no SQL Server
  supervisor  usuarios              @relation("supervisor", fields: [supervisor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  mecanico    usuarios?             @relation("mecanico", fields: [mecanico_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  categoria   categorias            @relation(fields: [categoria_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  veiculo     veiculos              @relation(fields: [veiculo_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  fechamento         registros_fechamento?
  anexos             anexos[]
  logs               logs_auditoria[]
  checklist_analise  checklist_analises?

  // Índices de performance (SDD § 4.3)
  @@index([status, mecanico_id])
  @@index([status, prazo])
  @@index([supervisor_id, criado_em(sort: Desc)])
  @@index([status, criado_em(sort: Desc)])
  @@index([status, fechado_em(sort: Desc)])
  @@index([categoria_id])
}

model registros_fechamento {
  id                Int      @id @default(autoincrement())
  ordem_servico_id  Int      @unique
  fechado_por_id    String   @db.UniqueIdentifier
  resultado         String   @db.NVarChar(20)
  nota_resolucao    String?  @db.NVarChar(280)
  horas_trabalhadas Decimal? @db.Decimal(6, 2)
  obs_adicionais    String?  @db.NVarChar(500)
  fechado_em        DateTime @db.DateTime2

  ordem_servico ordens_servico @relation(fields: [ordem_servico_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  fechado_por   usuarios       @relation(fields: [fechado_por_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model anexos {
  id               Int      @id @default(autoincrement())
  ordem_servico_id Int
  nome_arquivo     String   @db.NVarChar(255)
  url              String   @db.NVarChar(500)
  tipo             String?  @db.NVarChar(50)
  tamanho_bytes    Int?
  enviado_por_id   String   @db.UniqueIdentifier
  criado_em        DateTime @default(now()) @db.DateTime2

  ordem_servico ordens_servico @relation(fields: [ordem_servico_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  enviado_por   usuarios       @relation(fields: [enviado_por_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// D-10: tabela de auditoria imutável — nunca implementar UPDATE/DELETE
model logs_auditoria {
  id                BigInt   @id @default(autoincrement())
  ordem_servico_id  Int?
  ator_id           String   @db.UniqueIdentifier
  acao              String   @db.NVarChar(100)
  valores_anteriores String? @db.NVarChar(Max)
  novos_valores     String?  @db.NVarChar(Max)
  ocorrido_em       DateTime @default(now()) @db.DateTime2

  ordem_servico ordens_servico? @relation(fields: [ordem_servico_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ator          usuarios        @relation(fields: [ator_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  // Índice de performance (SDD § 4.3)
  @@index([ordem_servico_id, ocorrido_em(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo: Checklists Cobli (D-C01..D-C10 — ver docs/checklists-cobli-implementation-plan.md)
// ─────────────────────────────────────────────────────────────────────────────

// Histórico de cada execução de sincronização com a API Cobli
model cobli_checklists_sync {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  synced_at      DateTime  @default(now()) @db.DateTime2
  period_start   DateTime? @db.DateTime2
  period_end     DateTime? @db.DateTime2
  total_imported Int       @default(0)
  total_skipped  Int       @default(0)
  total_failed   Int       @default(0)
  status         String    @db.NVarChar(20)
  error_message  String?   @db.NVarChar(Max)
  created_at     DateTime  @default(now()) @db.DateTime2
  updated_at     DateTime  @updatedAt @db.DateTime2
}

// Cada checklist preenchido importado da Cobli
model checklist_resultados {
  id                      String    @id @default(uuid()) @db.UniqueIdentifier
  cobli_checklist_id      String    @unique @db.NVarChar(100)
  cobli_template_id       String?   @db.NVarChar(100)
  nome_checklist          String    @db.NVarChar(300)
  versao                  Int?
  veiculo_device_id       String?   @db.NVarChar(50)
  veiculo_placa           String?   @db.NVarChar(20)
  veiculo_marca           String?   @db.NVarChar(100)
  veiculo_modelo          String?   @db.NVarChar(200)
  veiculo_group_id        String?   @db.NVarChar(100)
  motorista_nome          String?   @db.NVarChar(200)
  endereco_preenchimento  String?   @db.NVarChar(500)
  preenchido_em           DateTime? @db.DateTime2
  criado_em_cobli         DateTime? @db.DateTime2
  importado_em            DateTime  @default(now()) @db.DateTime2
  status                  String    @default("CONFORME") @db.NVarChar(20)
  pontuacao_criticidade   Int       @default(0)
  prioridade              String?   @db.NVarChar(20)
  payload_original        String    @db.NVarChar(Max)
  created_at              DateTime  @default(now()) @db.DateTime2
  updated_at              DateTime  @updatedAt @db.DateTime2

  itens_nao_conformes checklist_itens_nao_conformes[]
  analise             checklist_analises?

  @@index([status])
  @@index([prioridade])
  @@index([preenchido_em])
  @@index([veiculo_placa])
  @@index([motorista_nome])
}

// Itens específicos que causaram não conformidade em um checklist
model checklist_itens_nao_conformes {
  id                     String   @id @default(uuid()) @db.UniqueIdentifier
  checklist_resultado_id String   @db.UniqueIdentifier
  field_id               String?  @db.NVarChar(100)
  field_title            String   @db.NVarChar(500)
  field_type             String   @db.NVarChar(20)
  valor_respondido       String   @db.NVarChar(500)
  peso_criticidade       Int      @default(1)
  photos_urls            String?  @db.NVarChar(Max)
  created_at             DateTime @default(now()) @db.DateTime2
  updated_at             DateTime @updatedAt @db.DateTime2

  checklist_resultado checklist_resultados @relation(fields: [checklist_resultado_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([checklist_resultado_id])
}

// Registro da decisão do supervisor/admin sobre um checklist não conforme
model checklist_analises {
  id                     String    @id @default(uuid()) @db.UniqueIdentifier
  checklist_resultado_id String    @unique @db.UniqueIdentifier
  analisado_por_id       String    @db.UniqueIdentifier
  analisado_em           DateTime  @db.DateTime2
  decisao                String    @db.NVarChar(20)
  observacao             String?   @db.NVarChar(Max)
  os_gerada_id           Int?      @unique
  created_at             DateTime  @default(now()) @db.DateTime2
  updated_at             DateTime  @updatedAt @db.DateTime2

  checklist_resultado checklist_resultados @relation(fields: [checklist_resultado_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  analisado_por       usuarios             @relation(fields: [analisado_por_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  os_gerada           ordens_servico?      @relation(fields: [os_gerada_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// Configuração de peso por padrão de título de campo (configurável por admin)
model checklist_item_weights {
  id                  String   @id @default(uuid()) @db.UniqueIdentifier
  field_title_pattern String   @db.NVarChar(200)
  field_title         String   @default("") @db.NVarChar(300)
  field_type          String   @default("SINGLE_SELECT") @db.NVarChar(50)
  peso                Int      @default(1)
  descricao           String?  @db.NVarChar(500)
  ativo               Boolean  @default(true)
  created_at          DateTime @default(now()) @db.DateTime2
  updated_at          DateTime @updatedAt @db.DateTime2
}
