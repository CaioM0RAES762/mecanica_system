# =============================================================
# METALSIDER — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# =============================================================

# ----- FRONTEND (apps/web) -----

# Chave secreta para assinar a sessão JWT do NextAuth (min 32 chars)
NEXTAUTH_SECRET=troque_por_uma_chave_secreta_de_pelo_menos_32_caracteres

# URL pública da aplicação (usada pelo NextAuth para callbacks)
NEXTAUTH_URL=http://localhost:3000

# URL base da API interna Fastify (acessada pelo BFF Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ----- BACKEND (apps/api) -----

# Chave secreta para verificar JWTs emitidos/validados pela API Fastify
JWT_SECRET=troque_por_outra_chave_secreta_de_pelo_menos_32_caracteres

# Rounds de salt do bcrypt (padrão: 12)
BCRYPT_SALT_ROUNDS=12

# Validade do código de verificação em minutos (padrão: 30)
CODE_EXPIRY_MINUTES=30

# ----- BANCO DE DADOS -----

# Prisma connection string para SQL Server
# Formato: sqlserver://HOST:PORT;database=NOME;user=USUARIO;password=SENHA;encrypt=true
DATABASE_URL=sqlserver://localhost:1433;database=metalsider;user=sa;password=MetalsiderDev@2026;encrypt=false;trustServerCertificate=true;connection_limit=5;pool_timeout=10

# ----- REDIS -----

# URL de conexão Redis (ioredis)
REDIS_URL=redis://localhost:6379

# ----- E-MAIL (Nodemailer / Gmail SMTP) — D-55 -----

# Servidor SMTP
EMAIL_HOST=smtp.gmail.com

# Porta SMTP (587 = STARTTLS, 465 = SSL)
EMAIL_PORT=587

# Usar SSL direto? (false para STARTTLS com port 587)
EMAIL_SECURE=false

# Conta Gmail usada para envio
EMAIL_USER=seu_email@gmail.com

# Senha de app do Gmail (nunca commitar o valor real)
EMAIL_PASSWORD=sua_senha_de_app_aqui

# Nome e endereço exibidos no campo "De"
EMAIL_FROM="Metalsider System <seu_email@gmail.com>"

# ----- MICROSOFT GRAPH API (legado — não usado pelo email service) -----

# ID do tenant Azure da Metalsider
GRAPH_TENANT_ID=seu_tenant_id_azure

# Client ID do app registration no Azure AD
GRAPH_CLIENT_ID=seu_client_id

# Secret do app registration no Azure AD
GRAPH_CLIENT_SECRET=seu_client_secret

# E-mail remetente corporativo
GRAPH_SENDER_EMAIL=noreply@metalsider.com.br

# ----- AZURE BLOB STORAGE (uploads) -----

# Connection string do Azure Blob Storage
AZURE_STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Nome do container para arquivos da aplicação
AZURE_STORAGE_CONTAINER=metalsider-anexos

# ----- OBSERVABILIDADE -----

# Application Insights connection string (ou OTLP endpoint)
APPINSIGHTS_CONNECTION=InstrumentationKey=...;IngestionEndpoint=...

# ----- AMBIENTE -----

# Ambiente de execução: development | staging | production
NODE_ENV=development

# Porta da API Fastify
API_PORT=4000

# Porta do frontend Next.js
WEB_PORT=3000

# Popular dados de demonstração no seed (true apenas em dev)
SEED_DEMO_DATA=true

# ----- JOBS (Sprint 11) -----

# UUID do usuário admin usado como ator nos logs de auditoria gerados pelos jobs automáticos.
# Se não configurado, o job buscará o primeiro admin ativo no banco no startup.
# Após rodar o seed, copie o UUID do admin para cá.
SYSTEM_USER_ID=

# ----- COBLI INTEGRATION (Módulo Checklists) -----

# URL base da API Cobli
COBLI_API_URL=https://api.cobli.co

# API Key gerada no painel Cobli (Configurações → Chaves de API)
# NUNCA expor esta chave no frontend ou commitar o valor real
COBLI_API_KEY=

# Habilitar sync automático de checklists (false em dev, true em produção quando pronto)
COBLI_CHECKLIST_SYNC_ENABLED=false

# Intervalo do sync automático em minutos
COBLI_CHECKLIST_SYNC_INTERVAL_MINUTES=15

# Janela de busca retroativa em horas (sync usa as últimas N horas)
COBLI_CHECKLIST_SYNC_LOOKBACK_HOURS=2

# ----- SEED: Usuário admin inicial -----

# E-mail do primeiro usuário admin (obrigatório para rodar o seed)
SEED_ADMIN_EMAIL=admin@metalsider.com.br

# Senha do admin inicial — será armazenada como hash bcrypt (obrigatório)
SEED_ADMIN_PASSWORD=Admin@2026!Troque

# Nome completo do admin inicial
SEED_ADMIN_NOME=Administrador


